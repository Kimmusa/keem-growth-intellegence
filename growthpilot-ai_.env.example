# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/growthpilot?schema=public"

# Generate a long random secret (at least 32 characters)
AUTH_SECRET="replace-with-a-long-random-secret"

# OpenAI API key (server-side only)
OPENAI_API_KEY=""

# Optional model override
OPENAI_MODEL="gpt-4.1-mini"

# Optional public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional scheduled-job secret for /api/cron/daily-quests
CRON_SECRET="replace-with-another-long-random-secret"
